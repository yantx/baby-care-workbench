.page {
  padding: 20rpx 24rpx 40rpx;
}

.baby-bar {
  display: flex;
  align-items: baseline;
  padding: 10rpx 8rpx 20rpx;
}

.baby-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.days-old {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #ff8a65;
}

.sync-tip {
  text-align: center;
  font-size: 24rpx;
  color: #ff8a65;
  margin-bottom: 16rpx;
}

.stats-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.status-card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.status-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.status-row + .status-row {
  border-top: 1rpx solid #f5f5f5;
}

.status-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.status-text {
  font-size: 26rpx;
  color: #666;
}

.quick-record {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.quick-grid {
  display: flex;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.quick-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.timeline-card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.more {
  font-size: 24rpx;
  font-weight: 400;
  color: #999;
}

.empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #bbb;
}

.timeline-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.timeline-item + .timeline-item {
  border-top: 1rpx solid #f5f5f5;
}

.tl-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.tl-body {
  flex: 1;
  min-width: 0;
}

.tl-main {
  display: flex;
  align-items: center;
}

.tl-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.tl-by {
  font-size: 22rpx;
  color: #bbb;
}

.tl-detail {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tl-time {
  font-size: 26rpx;
  color: #999;
}
