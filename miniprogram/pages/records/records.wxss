.page {
  padding: 20rpx 24rpx 120rpx;
}

.toolbar {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.date-btn {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-item {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: #f5f5f5;
  font-size: 22rpx;
  color: #666;
}

.filter-item.on {
  background: #ff8a65;
  color: #fff;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  font-size: 26rpx;
  color: #bbb;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.record-card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.record-main {
  display: flex;
  align-items: flex-start;
}

.record-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.record-body {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.record-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.record-detail {
  font-size: 26rpx;
  color: #ff8a65;
}

.record-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.record-by {
  margin-left: 8rpx;
}

.record-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
}

.record-del {
  font-size: 22rpx;
  color: #ccc;
  padding: 6rpx 0 0 20rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #ff8a65;
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.4);
}
