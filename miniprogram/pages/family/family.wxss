.page {
  padding: 20rpx 24rpx 40rpx;
}

.family-card {
  background: linear-gradient(135deg, #ff8a65, #ffab91);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  color: #fff;
}

.family-name {
  font-size: 40rpx;
  font-weight: 600;
}

.family-count {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.section-title {
  margin: 36rpx 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.member-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.member-card {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.member-card + .member-card {
  border-top: 1rpx solid #f5f5f5;
}

.member-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 28rpx;
  color: #333;
}

.member-role {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.owner-tag {
  font-size: 20rpx;
  color: #ff8a65;
  background: #fff0ea;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.invite-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.invite-code {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  color: #ff8a65;
}

.invite-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.invite-btn {
  margin-top: 24rpx;
  background: #fff0ea;
  color: #ff8a65;
}

.join-btn {
  margin-top: 30rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  border-radius: 60rpx;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.modal {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.modal-input {
  margin-top: 30rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 32rpx;
  text-align: center;
  letter-spacing: 8rpx;
}

.modal-btns {
  margin-top: 30rpx;
  display: flex;
  justify-content: space-around;
}
