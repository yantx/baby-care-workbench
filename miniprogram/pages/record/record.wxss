.page {
  padding: 20rpx 24rpx 40rpx;
}

.type-bar {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #666;
  padding: 10rpx 0;
  border-radius: 16rpx;
}

.type-item.active {
  background: #fff0ea;
  color: #ff8a65;
  font-weight: 600;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.form-card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.form-row + .form-row {
  border-top: 1rpx solid #f5f5f5;
}

.form-row.column {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  width: 180rpx;
  font-size: 26rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

.form-textarea {
  width: 100%;
  margin-top: 16rpx;
  font-size: 26rpx;
  min-height: 120rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

.hint {
  padding: 0 0 20rpx;
  font-size: 22rpx;
  color: #bbb;
}

.seg {
  display: flex;
  flex: 1;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
}

.seg-item {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  font-size: 24rpx;
  color: #666;
}

.seg-item.on {
  background: #ff8a65;
  color: #fff;
}

.save-btn {
  margin-top: 40rpx;
  border-radius: 60rpx;
  background: #ff8a65;
  font-size: 32rpx;
}
