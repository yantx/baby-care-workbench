.page {
  padding: 20rpx 24rpx 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff8a65, #ffab91);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  color: #fff;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 28rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.menu-card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.menu-item + .menu-item {
  border-top: 1rpx solid #f5f5f5;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}

.logout-btn {
  margin-top: 40rpx;
  background: #fff;
  color: #e57373;
  font-size: 28rpx;
  border-radius: 60rpx;
}

.version {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
